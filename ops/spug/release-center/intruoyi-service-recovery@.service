[Unit]
Description=IntRuoyi bounded service recovery (%i)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/intruoyi-maintenance/ops/spug/release-center
ExecStart=/usr/bin/python3 -B /opt/intruoyi-maintenance/ops/spug/release-center/service_recovery.py --config /etc/intruoyi-service-recovery/%i.json run
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
